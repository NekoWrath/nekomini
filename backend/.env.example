# ==========================================
# Telegram Bot & Mini App Configuration
# ==========================================

# Токен вашего Telegram бота (получите у @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# URL опубликованного фронтенда Mini App (например https://your-domain.com или https://abc.ngrok-free.app)
WEBAPP_URL=https://your-domain.com

# ID стримера и модераторов через запятую (получите свой ID через @userinfobot)
ADMIN_IDS=123456789,987654321

# Имя/никнейм стримера для отображения
STREAMER_NAME=StreamerLegend
STREAMER_AVATAR=https://images.unsplash.com/photo-1566492031773-4f4e44671857?w=150&auto=format&fit=crop&q=80
TWITCH_URL=https://twitch.tv/streamer
KICK_URL=https://kick.com/streamer
VK_URL=https://live.vkvideo.ru/streamer
TELEGRAM_CHANNEL=https://t.me/streamer_channel

# Режим разработки (True позволяет тестировать в браузере без валидации initData)
DEBUG_MODE=True

# База данных (SQLite по умолчанию)
DATABASE_URL=sqlite+aiosqlite:///./tma_streamer.db

# Настройки сервера API
API_HOST=0.0.0.0
API_PORT=8000
